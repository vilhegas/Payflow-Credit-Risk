      "boundElements": [],
      "updated": 1793640290100,
      "link": null,
      "locked": false,
      "text": "A PayFlow (fintech fictícia) oferece crédito digital (empréstimo \npessoal, cartão e BNPL). Nos últimos meses, a empresa percebeu um aumento de \n**inadimplência nos primeiros 90 dias** após a concessão.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A PayFlow (fintech fictícia) oferece crédito digital (empréstimo \npessoal, cartão e BNPL). Nos últimos meses, a empresa percebeu um aumento de \n**inadimplência nos primeiros 90 dias** após a concessão.",
      "autoResize": true,
      "lineHeight": 1.25
    },
