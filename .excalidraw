      "seed": 1227118743,
      "version": 774,
      "versionNonce": 1736145431,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793640298961,
      "link": null,
      "locked": false,
      "text": "• Perda financeira direta (default)\n• Risco operacional (time de cobrança sobrecarregado)\n• Crescimento travado (medo de liberar crédito e piorar a carteira)\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Perda financeira direta (default)\n• Risco operacional (time de cobrança sobrecarregado)\n• Crescimento travado (medo de liberar crédito e piorar a carteira)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
